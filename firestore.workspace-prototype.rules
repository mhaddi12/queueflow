rules_version = '2';
// /workspaces/{uid}: private owner workspace snapshot.
// ownerId: immutable string, 1..128; payload: JSON string, 2..400000;
// revision: integer 1..2147483647; createdAt: immutable timestamp;
// updatedAt: server timestamp. Payload conveys no roles or billing privileges.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null && request.auth.token.email_verified == true; }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function uidUnchanged(uid) { return request.resource.data.ownerId == uid; }
    function uidNotModified() { return request.resource.data.ownerId == resource.data.ownerId; }
    function isValidWorkspace(data) {
      return data.keys().hasAll(['ownerId','payload','revision','createdAt','updatedAt'])
        && data.keys().hasOnly(['ownerId','payload','revision','createdAt','updatedAt'])
        && data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128
        && data.payload is string && data.payload.size() >= 2 && data.payload.size() <= 400000
        && data.revision is int && data.revision > 0 && data.revision <= 2147483647
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }
    match /workspaces/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && uidUnchanged(uid)
        && isValidWorkspace(request.resource.data)
        && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && uidUnchanged(uid) && uidNotModified()
        && isValidWorkspace(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
