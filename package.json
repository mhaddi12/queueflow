{
  "name": "queueflow",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "node server.mjs",
    "build": "node scripts/prepare-next.mjs && next build && node scripts/finish-export.mjs",
    "test:rules": "node --test tests/firebase-rules.emulator.mjs",
    "build:legacy": "node scripts/build-firebase.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "next dev"
  },
  "dependencies": {
    "firebase": "13.1.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  }
}
